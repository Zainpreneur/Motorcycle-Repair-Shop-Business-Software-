// Prisma schema for the Motorcycle Repair Shop Business Software
// Default datasource is SQLite for zero-config local development.
// For production, swap provider to "postgresql" and set DATABASE_URL accordingly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so Prisma requires plain strings here.
// Valid values are enforced at the API layer with zod:
//   Role:              ADMIN | MANAGER | TECHNICIAN | FRONTDESK
//   WorkOrderStatus:   PENDING | IN_PROGRESS | WAITING_PARTS | COMPLETED | INVOICED | CANCELLED
//   AppointmentStatus: SCHEDULED | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW
//   InvoiceStatus:     UNPAID | PARTIAL | PAID | VOID
//   Priority:          LOW | NORMAL | HIGH | URGENT

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("FRONTDESK")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrders    WorkOrder[] @relation("TechnicianWorkOrders")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  motorcycles   Motorcycle[]
  workOrders    WorkOrder[]
  appointments  Appointment[]
}

model Motorcycle {
  id            String   @id @default(cuid())
  customerId    String
  make          String
  model         String
  year          Int?
  vin           String?
  licensePlate  String?
  color         String?
  mileage       Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders    WorkOrder[]
  appointments  Appointment[]
}

model Appointment {
  id            String      @id @default(cuid())
  customerId    String
  motorcycleId  String?
  scheduledAt   DateTime
  reason        String?
  status        String      @default("SCHEDULED")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  motorcycle    Motorcycle? @relation(fields: [motorcycleId], references: [id], onDelete: SetNull)
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  category        String?
  defaultRate     Float    @default(0)
  estimatedHours  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrderServices WorkOrderService[]
}

model Part {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  description       String?
  category          String?
  quantityInStock   Int      @default(0)
  reorderLevel      Int      @default(5)
  unitCost          Float    @default(0)
  unitPrice         Float    @default(0)
  supplier          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workOrderParts    WorkOrderPart[]
}

model WorkOrder {
  id            String     @id @default(cuid())
  // Human-friendly sequential ticket number, assigned in application code
  // (SQLite doesn't support @default(autoincrement()) on a non-id field).
  number        Int        @unique
  customerId    String
  motorcycleId  String
  technicianId  String?
  status        String     @default("PENDING")
  priority      String     @default("NORMAL")
  complaint     String?
  diagnosis     String?
  notes         String?
  odometerIn    Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  customer      Customer   @relation(fields: [customerId], references: [id])
  motorcycle    Motorcycle @relation(fields: [motorcycleId], references: [id])
  technician    User?      @relation("TechnicianWorkOrders", fields: [technicianId], references: [id])

  services      WorkOrderService[]
  parts         WorkOrderPart[]
  invoice       Invoice?
}

model WorkOrderService {
  id            String   @id @default(cuid())
  workOrderId   String
  serviceId     String?
  description   String
  laborHours    Float    @default(0)
  laborRate     Float    @default(0)
  total         Float    @default(0)

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service       Service?  @relation(fields: [serviceId], references: [id])
}

model WorkOrderPart {
  id            String   @id @default(cuid())
  workOrderId   String
  partId        String
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  total         Float    @default(0)

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part          Part      @relation(fields: [partId], references: [id])
}

model Invoice {
  id            String    @id @default(cuid())
  // Human-friendly sequential invoice number, assigned in application code
  // (SQLite doesn't support @default(autoincrement()) on a non-id field).
  number        Int       @unique
  workOrderId   String    @unique
  subtotal      Float     @default(0)
  taxRate       Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  amountPaid    Float     @default(0)
  status        String    @default("UNPAID")
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  paidAt        DateTime?

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  payments      Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  amount      Float
  method      String   @default("cash")
  notes       String?
  paidAt      DateTime @default(now())

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
